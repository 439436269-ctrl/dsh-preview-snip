{
  "name": "dsh-preview-snip",
  "version": "0.2.0",
  "description": "Circle a region or quote selected text in an image/PDF preview and insert it into the DSH composer.",
  "type": "module",
  "license": "MIT",
  "author": "439436269-ctrl",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "preview",
    "screenshot",
    "snip",
    "annotate"
  ],
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "VERIFY.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar-documentpreview"
      ]
    },
    "compatibility": {
      "dshReleases": {
        "0.2.0-rc.2": "compatible",
        "0.2.1-rc.2": "compatible"
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/439436269-ctrl/dsh-preview-snip.git"
  },
  "homepage": "https://github.com/439436269-ctrl/dsh-preview-snip#readme",
  "bugs": {
    "url": "https://github.com/439436269-ctrl/dsh-preview-snip/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "test": "node --test test/*.test.js"
  }
}
